# GitHub Personal Access Token (optional, but highly recommended to avoid 60 req/hr rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# OpenRouter API Key (required for OpenAI embedding model: openai/text-embedding-3-small)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Upstash Redis (optional; if not provided, in-memory cache is used automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
